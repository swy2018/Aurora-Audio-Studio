<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Process-only UTF-8 on Windows 10 1903+. Upstream SoX executable is unchanged.
     https://learn.microsoft.com/windows/apps/design/globalizing/use-utf8-code-page -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Aurora.SoX.UTF8" version="14.4.2.0" />
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>

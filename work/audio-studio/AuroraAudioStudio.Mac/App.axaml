<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AuroraAudioStudio.Mac.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#F6FBF8" />
      <Setter Property="Foreground" Value="#17241F" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#165F4D" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" />
    </Style>
    <Style Selector="Button.selected"><Setter Property="Background" Value="#D9EEE6" /><Setter Property="Foreground" Value="#165F4D" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12,8" /><Setter Property="MinHeight" Value="40" /></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="8" /><Setter Property="MinHeight" Value="40" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  </Application.Styles>
</Application>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AuroraAudioStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Aurora Audio Studio</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>2.0.2-beta.1</Version>
    <FileVersion>2.0.2.0</FileVersion>
    <AssemblyVersion>2.0.2.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Aurora Audio Studio</Product>
    <Company>Aurora Contributors</Company>
    <Copyright>Copyright © 2026 Aurora Contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../AuroraAudioStudio.Core/ArtifactExport.cs" Link="Services/ArtifactExport.cs" />
    <EmbeddedResource Include="..\..\..\docs\release.json" LogicalName="Aurora.Release.json" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Fonts\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Tools\minimax_music3_webui.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\gradio_result_bridge.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\gradio_task_bridge.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\seed_vc_entry.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\workbench-ui.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\workbench-ui.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\workbench-i18n.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\ACE-Step-Translations-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- System prerequisites are embedded by Inno, not retained in the installed application. -->
    <Content Include="Runtime\**\*" Exclude="Runtime\prerequisites\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <Target Name="CopyWinUIRuntimeResources" AfterTargets="Publish">
    <ItemGroup>
      <_AuroraXamlResource Include="$(TargetDir)*.xbf" />
      <_AuroraXamlResource Include="$(TargetDir)$(AssemblyName).pri" />
      <_AuroraAsset Include="$(TargetDir)Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AuroraXamlResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AuroraAsset)" DestinationFiles="@(_AuroraAsset->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RequireBundledModelTools" BeforeTargets="Publish">
    <Error Condition="!Exists('Runtime/bin/sox/sox.exe.manifest')" Text="SoX Unicode manifest missing. Run tools/Prepare-WindowsRuntime.ps1 before publishing." />
    <Error Condition="!Exists('Runtime/bin/uv/uv.exe') Or !Exists('Runtime/bin/git/cmd/git.exe') Or !Exists('Runtime/bin/ffmpeg/bin/ffmpeg.exe') Or !Exists('Runtime/bin/ffmpeg/bin/ffprobe.exe') Or !Exists('Runtime/bin/sox/sox.exe')"
           Text="Model tools missing. Run tools/Prepare-WindowsRuntime.ps1 before publishing; a package that requires preinstalled tools must not ship." />
    <Error Condition="!Exists('Runtime/prerequisites/vc_redist.x64.exe')" Text="Verified Visual C++ prerequisite is missing. Run tools/Prepare-WindowsRuntime.ps1 before publishing." />
    <Error Condition="!Exists('Runtime/prerequisites/MicrosoftEdgeWebView2RuntimeInstallerX64.exe')" Text="Verified offline WebView2 prerequisite is missing. Run tools/Prepare-WindowsRuntime.ps1 before publishing." />
  </Target>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
